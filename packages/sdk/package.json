{
  "name": "pulsekit-sdk",
  "version": "0.1.0",
  "description": "One-call notification client for PulseKit — multi-channel delivery, retries, and real-time status.",
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "notifications",
    "alerting",
    "email",
    "slack",
    "push",
    "sdk",
    "developer-tools"
  ]
}
